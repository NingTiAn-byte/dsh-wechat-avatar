{
  "name": "dsh-wechat-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "微信 IM 值守最小 demo：用 weflow-cli 拉群消息，规则判定哪条是派给我的活；左侧栏带管理页",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "config.json",
    "README.md"
  ],
  "engines": { "node": ">=22.5" },
  "scripts": {
    "demo": "node bin/demo.js --mock",
    "demo:live": "node bin/demo.js",
    "selftest": "node bin/selftest.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
